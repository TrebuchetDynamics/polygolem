      "secret": "c2VjcmV0",
      "passphrase": "pass-1",
      "timestamp": 1700000000,
      "method": "POST",
      "path": "/order",
      "body": "{\"token_id\":\"123\"}",
      "expected_headers": {
        "POLY_API_KEY": "key-1",
        "POLY_PASSPHRASE": "pass-1",
        "POLY_TIMESTAMP": "1700000000",
        "POLY_SIGNATURE": "DlLZ3_8yQ4of4tSILTf0hIMwQ6sqtPF_YOGQu0B7wIQ="
