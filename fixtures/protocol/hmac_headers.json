{
  "schema_version": 1,
  "family": "polymarket-hmac-headers",
  "source": {
    "formula": "base64url(HMAC-SHA256(base64decode(secret), timestamp + method + path + body))",
    "reference_paths": [
      "internal/auth/l2.go",
      "opensource-projects/repos/go-builder-signing-sdk"
    ],
    "notes": "Synthetic credentials only. Values pin canonical body/path/timestamp signing for L2 CLOB auth and builder attribution headers. The external builder SDK is the cross-check target for future imported vectors."
  },
  "vectors": [
    {
      "name": "clob_l2_get_book_no_body",
      "kind": "l2",
      "api_key": "key-1",
      "secret": "c2VjcmV0",
      "passphrase": "pass-1",
      "timestamp": 1700000000,
      "method": "GET",
      "path": "/book",
      "body": null,
      "expected_headers": {
        "POLY_API_KEY": "key-1",
        "POLY_PASSPHRASE": "pass-1",
        "POLY_TIMESTAMP": "1700000000",
        "POLY_SIGNATURE": "sGnIqIS0w73jlTVhz44U7ULfi9vy6WvUM6twuXXWi-o="
      }
    },
    {
      "name": "clob_l2_post_order_compact_body",
