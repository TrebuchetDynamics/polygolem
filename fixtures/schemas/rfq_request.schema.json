{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trebuchetdynamics.github.io/polygolem/schemas/rfq_request.schema.json",
  "title": "Polygolem RFQ Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["side", "amount"],
  "anyOf": [
    { "required": ["market_id"] },
    { "required": ["token_id"] }
  ],
  "properties": {
    "market_id": { "type": "string" },
    "token_id": { "type": "string" },
    "side": { "type": "string", "enum": ["BUY", "SELL"] },
    "amount": { "type": "string", "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]*)?|0*\\.[0-9]*[1-9][0-9]*)$" },
    "expiration": { "type": "string", "format": "date-time" },
    "maker": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_order_id": { "type": "string" },
        "builder_code": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
